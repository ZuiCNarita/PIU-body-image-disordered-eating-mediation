# Parametric mediation g-formula
effect_estimates_modified_fn <- function(data, indices) { 
  
  
  d_fit_sample <- data[indices, ]
  d_baseline_for_pred <- d_fit_sample  
  n_obs <- nrow(d_baseline_for_pred)
  
  # Time-fixed confounding
  fixed_baseline_confounders_formula_part <- "AA1age + girl + bmiT1 + punishT1 +
  cohesionT1 + incomeT1 + AA79Fsep +  BFIQ + behavesubT1 + mothernriT1 + 
  fathernriT1 + friendnriT1 + sdqbulliedT1 + 
  coffeeT1 + noexerciseMT1 + smfqT1 + bodydisT1 + bingeT1 + purgeT1"
  
  # Mediator model
  current_L2_A0_V_formula_part <- paste("QpiuT1  +", fixed_baseline_confounders_formula_part)
  
  formula_M2_bodydis <- paste("bodydisT2 ~", current_L2_A0_V_formula_part)
  bodydisT2_model <- lm(formula(formula_M2_bodydis), data = d_fit_sample)
  sigma_bodydisT2 <- sigma(bodydisT2_model); if(is.null(sigma_bodydisT2) || is.na(sigma_bodydisT2) || sigma_bodydisT2 <= 1e-9) sigma_bodydisT2 <- 1e-6
  
  formula_M2_binge <- paste("bingeT2 ~", current_L2_A0_V_formula_part)
  bingeT2_model <- glm(formula(formula_M2_binge), data = d_fit_sample, family = binomial)  
  
  formula_M2_purge <- paste("purgeT2 ~", current_L2_A0_V_formula_part)
  purgeT2_model <- glm(formula(formula_M2_purge), data = d_fit_sample, family = binomial)  
  
  # Outcome model
  outcome_predictors_T3 <- c(
    "QpiuT1", fixed_baseline_confounders_formula_part, 
    "bodydisT2", "bingeT2", "purgeT2",     # M2
    "QpiuT1:bodydisT2", "QpiuT1:bingeT2", "QpiuT1:purgeT2", # E-M interactions
    "purgeT2:bodydisT2", "purgeT2:bingeT2", "bodydisT2:bingeT2" # M-M interactions 
  )
  outcome_model_formula_string_T3 <- paste(unique(outcome_predictors_T3), collapse = " + ")
  outcome_model_T3 <- glm(formula(paste("smfqT3 ~", outcome_model_formula_string_T3)),
                          data = d_fit_sample)
  
  # Simulate full history 
  simulate_full_history_fn <- function(baseline_data, A0_val) {
    sim_data <- baseline_data 
    sim_data$QpiuT1 <- A0_val  
    n_sim <- nrow(sim_data)
    
    # Simulated mediator distribution
    sim_data$bodydisT2       <- rnorm(n_sim, predict(bodydisT2_model, newdata = sim_data), sigma_bodydisT2)
    
    pred_prob_bingeT2 <- predict(bingeT2_model, newdata = sim_data, type = "response"); pred_prob_bingeT2 <- pmax(1e-6, pmin(1 - 1e-6, pred_prob_bingeT2))
    sim_data$bingeT2 <- rbinom(n_sim, 1, pred_prob_bingeT2)
    
    pred_prob_purgeT2 <- predict(purgeT2_model, newdata = sim_data, type = "response"); pred_prob_purgeT2 <- pmax(1e-6, pmin(1 - 1e-6, pred_prob_purgeT2))
    sim_data$purgeT2 <- rbinom(n_sim, 1, pred_prob_purgeT2)
    
    return(sim_data)
  }
  
  # Simulate data under A=1 and A=0, allowing mediators to respond naturally
  sim_data_A0_1 <- simulate_full_history_fn(d_baseline_for_pred, factor(1)) 
  sim_data_A0_0 <- simulate_full_history_fn(d_baseline_for_pred, factor(0)) 
  
  realized_bodydis_hist_A0_0 <- sim_data_A0_0[, c("bodydisT2")]
  realized_bodydis_hist_A0_1 <- sim_data_A0_1[, c("bodydisT2")]
  realized_binge_hist_A0_0 <- sim_data_A0_0[, c("bingeT2")]
  realized_binge_hist_A0_1 <- sim_data_A0_1[, c("bingeT2")]
  realized_purge_hist_A0_0 <- sim_data_A0_0[, c("purgeT2")]
  realized_purge_hist_A0_1 <- sim_data_A0_1[, c("purgeT2")]
  
  # Obtain G terms by permuting mediators
  G_bodydis_hist_A0_0 <- realized_bodydis_hist_A0_0
  G_bodydis_hist_A0_1 <- realized_bodydis_hist_A0_1
  
  G_binge_hist_A0_0 <- realized_binge_hist_A0_0
  G_binge_hist_A0_1 <- realized_binge_hist_A0_1
  
  G_purge_hist_A0_0 <- realized_purge_hist_A0_0
  G_purge_hist_A0_1 <- realized_purge_hist_A0_1
  
  # Calculate Q terms ---
  create_Q_dataset_modified_full <- function(baseline_data, A0_val_for_Q, 
                                             G_bodydis_hist_for_Q,
                                             G_binge_hist_for_Q,
                                             G_purge_hist_for_Q) { 
    q_data <- baseline_data 
    q_data$QpiuT1 <- A0_val_for_Q
    n_q_obs <- nrow(q_data)
    
    # Assign G histories
    q_data$bodydisT2 <- G_bodydis_hist_for_Q
    q_data$bingeT2 <- G_binge_hist_for_Q
    q_data$purgeT2 <- G_purge_hist_for_Q
    
    return(q_data)
  }
  
  # Predicted counterfactual values for outcome
  Q_A1_G0_L1 <- mean(predict(outcome_model_T3, newdata = create_Q_dataset_modified_full(d_baseline_for_pred, factor(1), 
                                                                                        G_bodydis_hist_A0_0,G_binge_hist_A0_0,G_purge_hist_A0_0), type = "response"), na.rm=TRUE)
  
  Q_A0_G0_L0 <- mean(predict(outcome_model_T3, newdata = create_Q_dataset_modified_full(d_baseline_for_pred, factor(0), 
                                                                                        G_bodydis_hist_A0_0,G_binge_hist_A0_0,G_purge_hist_A0_0), type = "response"), na.rm=TRUE)
  
  Q_A1_G1_L1 <- mean(predict(outcome_model_T3, newdata = create_Q_dataset_modified_full(d_baseline_for_pred, factor(1), 
                                                                                        G_bodydis_hist_A0_1, G_binge_hist_A0_1, G_purge_hist_A0_1), type = "response"), na.rm=TRUE)
  
  
  # Calculate TE, IDE, and TIE
  IDE <- Q_A1_G0_L1 - Q_A0_G0_L0
  TIE <- Q_A1_G1_L1 - Q_A1_G0_L1
  
  EY_A0_1_natural <- mean(predict(outcome_model_T3, newdata = sim_data_A0_1, type = "response"), na.rm=TRUE)
  EY_A0_0_natural <- mean(predict(outcome_model_T3, newdata = sim_data_A0_0, type = "response"), na.rm=TRUE)
  TE  <- EY_A0_1_natural - EY_A0_0_natural
  
  
  return(c(TE = TE, IDE = IDE, TIE = TIE))
}

